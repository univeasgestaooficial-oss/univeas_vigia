    }
}

function atualizarKpisDashboardPorCurso() {
    if (!Array.isArray(dadosBoletimAtual) || dadosBoletimAtual.length === 0) return;

    let somaMedias = 0;
    let qtdMedias = 0;
    let totalFaltas = 0;

    dadosBoletimAtual.forEach(d => {
        totalFaltas += obterFaltas(d);
        const media = calcularMediaDisciplina(d);
        if (media !== null && !isNaN(media)) {
            somaMedias += media;
            qtdMedias++;
        }
    });

    document.getElementById('dash-faltas').innerText = totalFaltas;
    if (qtdMedias > 0) {
        document.getElementById('dash-media').innerText = (somaMedias / qtdMedias).toFixed(1);
    }
}

