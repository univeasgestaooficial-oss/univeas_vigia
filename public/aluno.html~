<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UNIVEAS - Portal do Aluno</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-gray-50 text-gray-800 antialiased flex h-screen overflow-hidden">

<!-- ==========================================
     TELA DE LOGIN DO ALUNO
     ========================================== -->
<div id="tela-login" class="fixed inset-0 z-50 flex flex-col items-center justify-center p-4 bg-cover bg-center bg-no-repeat" style="background-image: url('https://images.unsplash.com/photo-1523050854058-8df90110c9f1?q=80&w=2070&auto=format&fit=crop');">
    <div class="absolute inset-0 bg-slate-900/85 backdrop-blur-sm"></div>

    <div class="relative z-10 bg-white p-8 rounded-3xl shadow-2xl max-w-sm w-full text-center border-t-4 border-blue-500">
        <div class="mx-auto mb-4 bg-blue-50 h-16 w-16 rounded-full flex items-center justify-center border border-blue-100">
            <img src="https://i.imgur.com/ki7mdS2.png" alt="UNIVEAS" class="mx-auto mb-6 h-14 w-auto object-contain">
        </div>
        <h2 class="text-2xl font-black text-gray-900 mb-1">Portal do Aluno</h2>
        <p class="text-sm text-gray-500 mb-6 font-medium">Acompanhe sua jornada acadêmica</p>

        <form id="form-login" class="space-y-4">
            <div>
                <input type="text" id="input-matricula" placeholder="Nº de Matrícula (Ex: #GER...)" required class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-blue-500 text-center font-bold uppercase">
            </div>
            <div>
                <input type="password" id="input-cpf" placeholder="CPF (Apenas números)" required class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-blue-500 text-center font-bold tracking-widest">
            </div>
            <button type="submit" id="btn-submit-login" class="w-full bg-blue-600 text-white font-bold py-3 rounded-xl text-xs uppercase tracking-wider hover:bg-blue-700 transition shadow-md">
                Acessar Portal
            </button>
        </form>
    </div>
</div>

<!-- ==========================================
     CONTAINER DO SISTEMA
     ========================================== -->
<div id="app-container" class="hidden h-full w-full flex-1 flex">

<div id="mobile-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 hidden md:hidden" onclick="toggleMenuMobile()"></div>

<aside class="w-64 bg-white border-r border-gray-200 flex flex-col transition-all duration-300 z-50 h-full shrink-0">
        <div class="h-20 flex items-center justify-center border-b border-gray-100 px-4">
            <img src="https://i.imgur.com/ki7mdS2.png" alt="UNIVEAS" class="h-14 w-auto object-contain">
        </div>

        <div class="flex-1 overflow-y-auto no-scrollbar py-4 px-2 space-y-1">
            <p class="px-4 text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 mt-2">Visão Geral</p>
            <button onclick="mudarTela('dashboard')" id="btn-dashboard" class="menu-btn w-full flex items-center px-4 py-2.5 bg-blue-50 text-blue-700 border-l-4 border-blue-500 font-bold rounded-r-lg transition-colors">
                <i data-feather="grid" class="h-5 w-5 mr-3"></i>
                <span class="text-sm">Painel Principal</span>
            </button>

            <p class="px-4 text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 mt-6">Acadêmico</p>
            <button onclick="mudarTela('boletim')" id="btn-boletim" class="menu-btn w-full flex items-center px-4 py-2.5 text-gray-500 border-l-4 border-transparent hover:bg-gray-50 hover:text-blue-600 font-medium rounded-r-lg transition-colors">
                <i data-feather="award" class="h-5 w-5 mr-3"></i>
                <span class="text-sm">Notas e Faltas (Boletim)</span>
            </button>
            <button onclick="mudarTela('material')" id="btn-material" class="menu-btn w-full flex items-center px-4 py-2.5 text-gray-500 border-l-4 border-transparent hover:bg-gray-50 hover:text-blue-600 font-medium rounded-r-lg transition-colors">
                <i data-feather="book-open" class="h-5 w-5 mr-3"></i>
                <span class="text-sm">Material Didático</span>
            </button>

            <p class="px-4 text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 mt-6">Secretaria</p>
            <button onclick="mudarTela('financeiro')" id="btn-financeiro" class="menu-btn w-full flex items-center px-4 py-2.5 text-gray-500 border-l-4 border-transparent hover:bg-gray-50 hover:text-blue-600 font-medium rounded-r-lg transition-colors">
                <i data-feather="dollar-sign" class="h-5 w-5 mr-3"></i>
                <span class="text-sm">Financeiro (Mensalidades)</span>
            </button>

            <p class="px-4 text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 mt-6">Conta</p>
            <button onclick="mudarTela('perfil')" id="btn-perfil" class="menu-btn w-full flex items-center px-4 py-2.5 text-gray-500 border-l-4 border-transparent hover:bg-gray-50 hover:text-blue-600 font-medium rounded-r-lg transition-colors">
                <i data-feather="user" class="h-5 w-5 mr-3"></i>
                <span class="text-sm">Meu Perfil</span>
            </button>
        </div>

        <div class="p-4 border-t border-gray-100">
            <button onclick="fazerLogout()" class="w-full flex items-center px-4 py-2 text-red-500 hover:bg-red-50 rounded-lg transition-colors font-medium">
                <i data-feather="log-out" class="h-5 w-5 mr-3"></i>
                <span class="text-sm">Sair do Portal</span>
            </button>
        </div>
    </aside>

    <div class="flex-1 flex flex-col h-screen overflow-hidden bg-gray-50/50">
        <header class="h-20 bg-white shadow-sm border-b border-gray-100 flex items-center justify-between px-6 z-10 shrink-0">
            <div class="flex items-center">
                <button onclick="toggleMenuMobile()" class="md:hidden text-gray-400 hover:text-blue-600 mr-4">
                    <i data-feather="menu" class="h-6 w-6"></i>
                </button>
                <h1 id="titulo-pagina" class="text-xl font-black text-gray-800 tracking-tight uppercase">Painel Principal</h1>
            </div>

            <div class="flex items-center space-x-4">
                <div class="text-right hidden sm:block">
                    <p id="nome-aluno-header" class="text-sm font-bold text-gray-900">Carregando...</p>
                    <p class="text-xs text-blue-600 font-medium" id="matricula-aluno-header">Portal do Aluno</p>
                </div>
                <div id="iniciais-header" onclick="mudarTela('perfil')" class="h-10 w-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center font-bold shadow-sm cursor-pointer hover:bg-blue-100 transition border border-blue-100">
                    --
                </div>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto p-6 md:p-8 no-scrollbar relative">

            <!-- ==========================================
                 TELA: DASHBOARD
                 ========================================== -->
            <div id="tela-dashboard" class="tela block">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold tracking-wider text-gray-400 uppercase">Média Geral</p>
                            <h3 id="dash-media" class="text-3xl font-black text-gray-800 mt-1">-</h3>
                        </div>
                        <div class="p-4 bg-blue-50 text-blue-500 rounded-xl">
                            <i data-feather="award" class="h-6 w-6"></i>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold tracking-wider text-gray-400 uppercase">Faltas Acumuladas</p>
                            <h3 id="dash-faltas" class="text-3xl font-black text-yellow-500 mt-1">0</h3>
                        </div>
                        <div class="p-4 bg-yellow-50 text-yellow-500 rounded-xl">
                            <i data-feather="clock" class="h-6 w-6"></i>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold tracking-wider text-gray-400 uppercase">Status Financeiro</p>
                            <h3 id="dash-financeiro" class="text-xl font-black text-green-500 mt-1">REGULAR</h3>
                        </div>
                        <div class="p-4 bg-green-50 text-green-500 rounded-xl">
                            <i data-feather="check-circle" class="h-6 w-6"></i>
                        </div>
                    </div>
                </div>

                <!-- SELECT DE CURSO DO DASHBOARD (EXIBIDO QUANDO HÁ MAIS DE 1 CURSO) -->
                <div id="box-select-curso-dash" class="hidden mb-6 flex justify-end">
                    <select id="select-curso-dash" class="border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-bold text-gray-700 focus:outline-none focus:border-blue-500 bg-white shadow-sm" onchange="trocarCursoDashboard()"></select>
                </div>

                <!-- CARROSSÉIS DE DISCIPLINAS POR SEMESTRE -->
                <div id="container-semestres-dash" class="space-y-8 mt-4">
                    <div class="text-center py-10">
                        <p class="text-gray-400 text-sm animate-pulse">Carregando matriz curricular...</p>
                    </div>
                </div>
            </div>

            <!-- ==========================================
                 TELA: DETALHES DA DISCIPLINA
                 ========================================== -->
            <div id="tela-disciplina" class="tela hidden">
                <div class="mb-4">
                    <button onclick="mudarTela('dashboard')" class="text-xs font-bold text-blue-600 bg-blue-50 px-4 py-2 rounded-lg flex items-center hover:bg-blue-100 transition w-fit">
                        <i data-feather="arrow-left" class="w-4 h-4 mr-2"></i> Voltar ao Painel
                    </button>
                </div>

                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col md:flex-row gap-6 mb-6">
                    <div id="disc-foto" class="w-full md:w-48 h-48 bg-gray-100 rounded-xl overflow-hidden shrink-0 border border-gray-200">
                        <img src="" alt="Capa" class="w-full h-full object-cover hidden">
                        <div class="w-full h-full flex items-center justify-center text-gray-400"><i data-feather="image" class="w-8 h-8"></i></div>
                    </div>
                    <div class="flex-1 flex flex-col justify-between">
                        <div>
                            <div class="flex gap-2 mb-2" id="disc-badges">
                                <span class="bg-blue-50 text-blue-700 border border-blue-200 px-2 py-1 rounded text-[10px] font-bold uppercase tracking-wider">PRESENCIAL</span>
                            </div>
                            <h2 id="disc-nome" class="text-2xl font-black text-gray-900 uppercase tracking-tight mb-1">Nome da Disciplina</h2>
                            <p id="disc-curso" class="text-sm font-bold text-gray-500 uppercase">Curso - Turma</p>
                        </div>

                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-4 pt-4 border-t border-gray-100 text-xs">
                            <div><span class="block text-[9px] text-gray-400 uppercase font-bold mb-0.5">Período</span><span id="disc-periodo" class="font-bold text-gray-800">--/-- a --/--</span></div>
                            <div><span class="block text-[9px] text-gray-400 uppercase font-bold mb-0.5">Carga Horária</span><span id="disc-ch" class="font-bold text-gray-800">40h</span></div>
                            <div><span class="block text-[9px] text-gray-400 uppercase font-bold mb-0.5">Faltas</span><span id="disc-faltas" class="font-bold text-yellow-600">0</span></div>
                            <div><span class="block text-[9px] text-gray-400 uppercase font-bold mb-0.5">Média Parcial</span><span id="disc-media" class="font-black text-blue-600 text-sm">-</span></div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-2 space-y-6">
                        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                            <h4 class="text-sm font-black text-gray-800 uppercase tracking-widest flex items-center mb-4 border-b border-gray-50 pb-3">
                                <i data-feather="file-text" class="mr-2 text-blue-500"></i> Ementa / Descrição
                            </h4>
                            <p id="disc-ementa" class="text-sm text-gray-600 leading-relaxed">Nenhuma ementa informada para esta disciplina.</p>
                        </div>

                        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                            <h4 class="text-sm font-black text-gray-800 uppercase tracking-widest flex items-center mb-4 border-b border-gray-50 pb-3">
                                <i data-feather="folder" class="mr-2 text-blue-500"></i> Materiais de Apoio da Disciplina
                            </h4>
                            <div id="disc-lista-materiais" class="space-y-3">
                                <p class="text-xs text-gray-400">Nenhum material vinculado.</p>
                            </div>
                        </div>
                    </div>

                    <div class="bg-orange-50/50 p-6 rounded-2xl shadow-sm border border-orange-100 h-fit">
                        <h4 class="text-sm font-black text-orange-800 uppercase tracking-widest flex items-center mb-4 border-b border-orange-100 pb-3">
                            <i data-feather="award" class="mr-2 text-orange-500"></i> Avaliações e Notas
                        </h4>
                        <div id="disc-lista-avaliacoes" class="space-y-3">
                           <!-- Preenchido via JS -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==========================================
                 TELA: BOLETIM ACADÊMICO
                 ========================================== -->
            <div id="tela-boletim" class="tela hidden">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col h-full min-h-[550px]">

                    <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 border-b border-gray-100 gap-4 mb-6">
                        <h4 class="text-lg font-bold text-gray-800 flex items-center shrink-0">
                            <span class="w-1 h-5 bg-blue-500 rounded mr-2 inline-block"></span>
                            Desempenho Acadêmico
                        </h4>
                        <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
                            <select id="select-curso-boletim" class="border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500 bg-white w-full sm:w-48" onchange="carregarBoletim()">
                                <option value="">Selecione o Curso...</option>
                            </select>
                            <select id="select-disciplina-boletim" class="border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500 bg-white w-full sm:w-56 hidden" onchange="renderizarDisciplinaSelecionada()">
                                <option value="">Selecione a Disciplina...</option>
                            </select>
                        </div>
                    </div>

                    <div class="overflow-x-auto border rounded-xl border-gray-100 mb-6 flex-1">
                        <table class="min-w-full divide-y divide-gray-100 text-sm text-left">
                            <thead class="bg-gray-50">
                                <tr id="thead-boletim" class="text-xs font-bold text-gray-500 uppercase tracking-wider">
                                    <th class="py-3 px-4">Disciplina / Módulo</th>
                                    <th class="py-3 px-4 text-center">Faltas</th>
                                    <th class="py-3 px-4 text-center">Média</th>
                                    <th class="py-3 px-4 text-center">Situação</th>
                                </tr>
                            </thead>
                            <tbody id="tbody-boletim" class="divide-y divide-gray-100 font-medium text-gray-700">
                                <tr>
                                    <td colspan="6" class="text-center py-8 text-gray-400">Selecione o curso acima para carregar suas notas.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="bg-gray-50 p-5 rounded-2xl border border-gray-100 mt-auto">
                        <div class="flex items-center justify-between mb-3">
                            <h5 class="text-xs font-bold text-gray-500 uppercase tracking-wider flex items-center">
                                <i data-feather="bar-chart-2" class="w-4 h-4 text-blue-500 mr-1.5"></i> Notas por Avaliação
                            </h5>
                        </div>
                        <div class="relative h-48 w-full">
                            <canvas id="graficoDesempenhoAluno"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==========================================
                 TELA: MATERIAL DIDÁTICO
                 ========================================== -->
            <div id="tela-material" class="tela hidden">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col min-h-[500px]">
                    <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 border-b border-gray-100 gap-4 mb-6">
                        <h4 class="text-lg font-bold text-gray-800 flex items-center shrink-0">
                            <span class="w-1 h-5 bg-blue-500 rounded mr-2 inline-block"></span>
                            Arquivos e Aulas Compartilhadas
                        </h4>
                        <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
                            <select id="select-curso-material" class="border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500 bg-white w-full sm:w-48" onchange="carregarMateriais()">
                                <option value="">Selecione o Curso...</option>
                            </select>
                            <select id="select-disciplina-material" class="border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500 bg-white w-full sm:w-56 hidden" onchange="filtrarMateriaisPorDisciplina()">
                                <option value="">Todas as Disciplinas</option>
                            </select>
                        </div>
                    </div>

                    <div id="lista-materiais-aluno" class="space-y-4 overflow-y-auto flex-1 pr-2">
                        <p class="text-sm text-gray-400 text-center py-8">Selecione um curso para ver os materiais disponíveis.</p>
                    </div>
                </div>
            </div>

            <!-- ==========================================
                 TELA: FINANCEIRO
                 ========================================== -->
            <div id="tela-financeiro" class="tela hidden">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                    <h4 class="text-lg font-bold text-gray-800 mb-6 flex items-center border-b border-gray-100 pb-4">
                        <span class="w-1 h-5 bg-blue-500 rounded mr-2 inline-block"></span>
                        Minhas Mensalidades
                    </h4>

                    <div class="overflow-x-auto border rounded-xl border-gray-100 mb-6">
                        <table class="min-w-full divide-y divide-gray-100 text-sm text-left">
                            <thead class="bg-gray-50">
                                <tr class="text-xs font-bold text-gray-500 uppercase tracking-wider">
                                    <th class="py-3 px-4">Ref. / Vencimento</th>
                                    <th class="py-3 px-4">Valor (R$)</th>
                                    <th class="py-3 px-4 text-center">Status</th>
                                    <th class="py-3 px-4 text-right">Ação / Comprovante</th>
                                </tr>
                            </thead>
                            <tbody id="tbody-financeiro" class="divide-y divide-gray-100 font-medium">
                                <tr>
                                    <td colspan="4" class="text-center py-8 text-gray-400">Buscando faturas...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="bg-blue-50 p-4 rounded-xl border border-blue-100 flex items-start gap-3">
                        <i data-feather="info" class="text-blue-500 shrink-0 mt-0.5"></i>
                        <p class="text-xs text-blue-800">Para pagamentos via PIX ou Depósito, utilize o botão "Anexar Comprovante" para enviar a foto do recibo à secretaria. O status mudará para "Pago" após a validação.</p>
                    </div>
                </div>
            </div>

            <!-- ==========================================
                 TELA: PERFIL
                 ========================================== -->
            <div id="tela-perfil" class="tela hidden">
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 max-w-3xl mx-auto">
                    <h4 class="text-lg font-bold text-gray-800 mb-6 flex items-center">
                        <span class="w-1 h-5 bg-blue-500 rounded mr-2 inline-block"></span>
                        Meus Dados Cadastrais
                    </h4>
                    <div class="flex flex-col sm:flex-row items-center gap-6 mb-8 border-b border-gray-100 pb-8">
                        <div id="perfil-iniciais" class="h-24 w-24 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-2xl border-2 border-blue-100">
                            --
                        </div>
                        <div class="text-center sm:text-left">
                            <h2 id="perfil-nome" class="text-xl font-black text-gray-900">Carregando...</h2>
                            <p id="perfil-matricula" class="text-sm text-gray-500 mb-3">Matrícula: --</p>
                        </div>
                    </div>

                    <form id="form-perfil-aluno" class="space-y-5" onsubmit="salvarPerfilAluno(event)">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-gray-500 uppercase mb-1">CPF</label>
                                <input type="text" id="perfil-cpf" readonly class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm bg-gray-50 text-gray-500 cursor-not-allowed">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-500 uppercase mb-1">E-mail</label>
                                <input type="email" id="perfil-email" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Telefone</label>
                                <input type="text" id="perfil-telefone" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Endereço Completo</label>
                                <input type="text" id="perfil-endereco" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
                            </div>
                        </div>

                        <div class="flex justify-end pt-6 border-t border-gray-100">
                            <button type="submit" id="btn-salvar-perfil" class="bg-blue-600 text-white font-bold py-2.5 px-8 rounded-xl text-xs uppercase tracking-wider hover:bg-blue-700 transition shadow-sm">Solicitar Atualização</button>
                        </div>
                    </form>
                </div>
            </div>

        </main>
    </div>
</div>

<script>
const API_BASE_URL = "/api/v1";
let cursosDoAluno = [];
let dadosBoletimAtual = [];
let materiaisCursoAtual = [];
let meuGraficoDesempenho = null;

document.addEventListener('DOMContentLoaded', () => {
    feather.replace();

    if (window.innerWidth < 768) {
        const sidebar = document.querySelector('aside');
        if (sidebar) sidebar.classList.add('-translate-x-full', 'absolute');
    }

    if (localStorage.getItem('token_siga_aluno')) {
        liberarAcessoAluno();
    }

    const formLogin = document.getElementById('form-login');
    if (formLogin) {
        formLogin.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btn-submit-login');
            btn.innerText = "Autenticando...";

            const matricula = document.getElementById('input-matricula').value.toUpperCase();
            const cpf = document.getElementById('input-cpf').value;

            const formData = new FormData();
            formData.append('matricula', matricula);
            formData.append('cpf', cpf);

            try {
                const response = await fetch(`${API_BASE_URL}/auth/aluno`, {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (response.ok && data.sucesso) {
                    localStorage.setItem('token_siga_aluno', data.token_siga);
                    localStorage.setItem('nome_aluno', data.nome_aluno);
                    localStorage.setItem('matricula_aluno', data.matricula);
                    liberarAcessoAluno();
                } else {
                    alert(data.detail || "Matrícula ou CPF incorretos. Procure a secretaria.");
                    btn.innerText = "Acessar Portal";
                }
            } catch (error) {
                alert("Erro ao conectar com o servidor.");
                btn.innerText = "Acessar Portal";
            }
        });
    }
});

function getIniciais(nome) {
    if (!nome) return '--';
    const partes = nome.trim().split(' ');
    if (partes.length === 1) return partes[0].substring(0, 2).toUpperCase();
    return (partes[0][0] + partes[partes.length - 1][0]).toUpperCase();
}

function obterFaltas(d) {
    if (!d) return 0;
    const raw = d.faltas ?? d.faltas_totais ?? d.total_faltas ?? d.qtd_faltas ?? 0;
    const num = parseInt(raw, 10);
    return isNaN(num) ? 0 : num;
}

function calcularMediaDisciplina(d) {
    if (!d) return null;
    if (d.media_final !== undefined && d.media_final !== null && d.media_final !== '') {
        const mf = parseFloat(d.media_final);
        if (!isNaN(mf)) return mf;
    }

    const notasObj = d.notas || {};
    const avalPrevistas = Array.isArray(d.avaliacoes_previstas) && d.avaliacoes_previstas.length > 0
        ? d.avaliacoes_previstas
        : Object.keys(notasObj);

    let soma = 0;
    let qtdValidas = 0;

    avalPrevistas.forEach(tipo => {
        const val = notasObj[tipo];
        if (val !== undefined && val !== null && val !== '') {
            const num = parseFloat(val);
            if (!isNaN(num)) {
                soma += num;
                qtdValidas++;
            }
        }
    });

    if (qtdValidas === 0) return null;
    return soma / qtdValidas;
}

function liberarAcessoAluno() {
    document.getElementById('tela-login').classList.add('hidden');
    document.getElementById('app-container').classList.remove('hidden');

    const nomeReal = localStorage.getItem('nome_aluno') || 'Aluno';
    const matReal = localStorage.getItem('matricula_aluno') || 'S/N';
    const iniciais = getIniciais(nomeReal);

    document.getElementById('nome-aluno-header').innerText = nomeReal;
    document.getElementById('matricula-aluno-header').innerText = "Matrícula: " + matReal;
    document.getElementById('iniciais-header').innerText = iniciais;

    document.getElementById('perfil-nome').innerText = nomeReal;
    document.getElementById('perfil-matricula').innerText = "Matrícula: " + matReal;
    document.getElementById('perfil-iniciais').innerText = iniciais;

    loadDashboardAluno();
    loadCursosAluno();
    loadPerfilFinanceiro();

    mudarTela('dashboard');
}

function fazerLogout() {
    localStorage.removeItem('token_siga_aluno');
    localStorage.removeItem('nome_aluno');
    localStorage.removeItem('matricula_aluno');
    location.reload();
}

async function apiRequest(endpoint, method = 'GET', data = null) {
    const headers = { 'Authorization': `Bearer ${localStorage.getItem('token_siga_aluno')}` };
    const config = { method, headers };

    if (data) {
        if (data instanceof FormData) {
            config.body = data;
        } else {
            headers['Content-Type'] = 'application/json';
            config.body = JSON.stringify(data);
        }
    }

    try {
        const response = await fetch(`${API_BASE_URL}${endpoint}`, config);
        if (response.status === 401) {
            alert("Sua sessão expirou.");
            fazerLogout();
            return null;
        }
        return await response.json();
    } catch (error) {
        console.error('Erro na API:', error);
        return null;
    }
}

