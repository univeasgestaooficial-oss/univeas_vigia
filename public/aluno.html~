async function salvarPerfilAluno(event) {
    event.preventDefault();
    const btn = document.getElementById('btn-salvar-perfil');
    const textoOriginal = btn.innerText;
    btn.disabled = true;
    btn.innerText = "Salvando...";

    const payload = {
        email: document.getElementById('perfil-email').value.trim(),
        telefone: document.getElementById('perfil-telefone').value.trim(),
        endereco: document.getElementById('perfil-endereco').value.trim()
    };

    try {
        let result = await apiRequest('/aluno/perfil', 'PUT', payload);
        if (!result || result.detail === 'Method Not Allowed') {
            result = await apiRequest('/aluno/perfil', 'POST', payload);
        }

        if (result && (result.sucesso || result.status === 'ok' || !result.detail)) {
            alert("Dados atualizados / solicitação enviada com sucesso!");
        } else {
            alert(result?.detail || "Não foi possível salvar os dados no momento.");
        }
    } catch (e) {
        alert("Erro ao enviar atualização de perfil.");
    } finally {
        btn.disabled = false;
        btn.innerText = textoOriginal;
    }
}

async function enviarComprovante(inputElement) {
    if (inputElement.files.length === 0) return;

    const file = inputElement.files[0];
    const formData = new FormData();
    formData.append('comprovante', file);

    const labelParent = inputElement.parentElement;
    const textOriginal = labelParent.innerHTML;
    labelParent.innerHTML = "Enviando...";

    const result = await apiRequest('/aluno/financeiro/comprovante', 'POST', formData);

    if (result && result.sucesso) {
        alert("Comprovante enviado com sucesso! A secretaria analisará e dará baixa em breve.");
        labelParent.innerHTML = `<span class="text-xs text-blue-600 font-bold"><i data-feather="clock" class="w-4 h-4 inline"></i> Em Análise</span>`;
        feather.replace();
    } else {
        alert("Erro ao enviar comprovante. Tente novamente.");
        labelParent.innerHTML = textOriginal;
    }
}

function mudarTela(idTela) {
    document.querySelectorAll('.tela').forEach(tela => {
        tela.classList.add('hidden');
        tela.classList.remove('block');
    });

    const telaAtiva = document.getElementById('tela-' + idTela);
    if (telaAtiva) {
        telaAtiva.classList.remove('hidden');
        telaAtiva.classList.add('block');
    }

    document.querySelectorAll('.menu-btn').forEach(btn => {
        btn.classList.remove('bg-blue-50', 'text-blue-700', 'border-blue-500', 'font-bold');
        btn.classList.add('text-gray-500', 'border-transparent', 'font-medium');
    });

    const btnAtivo = document.getElementById('btn-' + idTela);
    if (btnAtivo) {
        btnAtivo.classList.remove('text-gray-500', 'border-transparent', 'font-medium');
        btnAtivo.classList.add('bg-blue-50', 'text-blue-700', 'border-blue-500', 'font-bold');
    }

    const titulos = {
        'dashboard': 'Painel Principal',
        'disciplina': 'Detalhes da Disciplina',
        'boletim': 'Boletim Acadêmico',
        'material': 'Material Didático',
        'financeiro': 'Situação Financeira',
        'perfil': 'Meu Perfil'
    };
    document.getElementById('titulo-pagina').innerText = titulos[idTela] || 'Portal do Aluno';

    if (window.innerWidth < 768) {
        const sidebar = document.querySelector('aside');
        if (sidebar && !sidebar.classList.contains('-translate-x-full')) {
            toggleMenuMobile();
        }
    }
}

function toggleMenuMobile() {
    const sidebar = document.querySelector('aside');
    const backdrop = document.getElementById('mobile-backdrop');

    if (sidebar) {
        if (sidebar.classList.contains('-translate-x-full')) {
            sidebar.classList.remove('-translate-x-full', 'absolute');
            sidebar.classList.add('fixed', 'inset-y-0', 'left-0', 'shadow-2xl');
            if (backdrop) backdrop.classList.remove('hidden');
        } else {
            sidebar.classList.add('-translate-x-full', 'absolute');
            sidebar.classList.remove('fixed', 'inset-y-0', 'left-0', 'shadow-2xl');
            if (backdrop) backdrop.classList.add('hidden');
        }
    }
}

function getCapaPadraoCursoAtivo() {
    const selectBoletimEl = document.getElementById('select-curso-boletim');
    const cursoIdAtivo = selectBoletimEl ? selectBoletimEl.value : (cursosDoAluno[0]?.id || '');
    const cursoAtualObj = cursosDoAluno.find(c => String(c.id) === String(cursoIdAtivo)) || cursosDoAluno[0];
    return cursoAtualObj?.foto_capa || cursoAtualObj?.capa || 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=500&auto=format&fit=crop';
}

async function renderizarDashboardAluno() {
    const containerDash = document.getElementById('container-semestres-dash');
    if (!containerDash) return;

    const boletim = dadosBoletimAtual || [];
    if (boletim.length === 0) {
        containerDash.innerHTML = '<p class="text-sm text-gray-400 py-10 text-center">Nenhum módulo encontrado para este curso.</p>';
        return;
    }

    const capaPadraoCurso = getCapaPadraoCursoAtivo();
    const semestres = {};
    let semestreAtivo = null;

    boletim.forEach((disc, index) => {
        const sem = disc.semestre || 'Semestre Único';
        if (!semestres[sem]) semestres[sem] = { nome: sem, disciplinas: [], temCursando: false };
        disc.indexOriginal = index;

        if (disc.situacao && disc.situacao.toLowerCase() === 'cursando') {
            semestres[sem].temCursando = true;
            semestreAtivo = sem;
        }
        semestres[sem].disciplinas.push(disc);
    });

    if (!semestreAtivo && Object.keys(semestres).length > 0) {
        semestreAtivo = Object.keys(semestres)[0];
    }

    const semestresOrdenados = Object.values(semestres).sort((a, b) => {
        if (a.nome === semestreAtivo) return -1;
        if (b.nome === semestreAtivo) return 1;
        return 0;
    });

    containerDash.innerHTML = '';

    semestresOrdenados.forEach(semObj => {
        const isDestaque = semObj.nome === semestreAtivo;
        let cardsHTML = '';

        semObj.disciplinas.forEach(d => {
            const foto = (d.foto_modulo && d.foto_modulo.trim() !== '')
                ? d.foto_modulo.trim()
                : capaPadraoCurso;

            let badge = '<span class="absolute top-3 right-3 bg-gray-100 text-gray-600 text-[9px] font-black px-2 py-1 rounded shadow uppercase">Pendente</span>';

            if (d.situacao && d.situacao.toLowerCase() === 'aprovado') {
                badge = '<span class="absolute top-3 right-3 bg-green-500 text-white text-[9px] font-black px-2 py-1 rounded shadow uppercase">Concluído</span>';
            } else if (d.situacao && d.situacao.toLowerCase() === 'reprovado') {
                badge = '<span class="absolute top-3 right-3 bg-red-500 text-white text-[9px] font-black px-2 py-1 rounded shadow uppercase">Reprovado</span>';
            } else if (d.situacao && d.situacao.toLowerCase() === 'cursando') {
                badge = '<span class="absolute top-3 right-3 bg-blue-500 text-white text-[9px] font-black px-2 py-1 rounded shadow uppercase animate-pulse">Em Andamento</span>';
            }

            const nomeDisciplina = d.disciplina || d.nome_disciplina || 'Disciplina';

            cardsHTML += `
                <div onclick="abrirTelaDisciplina(${d.indexOriginal})" class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-md hover:border-blue-400 transition cursor-pointer min-w-[260px] w-[260px] flex-shrink-0 relative group">
                    ${badge}
                    <div class="h-32 bg-gray-100 overflow-hidden">
                        <img src="${foto}" alt="${nomeDisciplina}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 pointer-events-none">
                    </div>
                    <div class="p-4">
                        <p class="text-[9px] font-black text-blue-500 uppercase tracking-widest mb-1">Módulo Acadêmico</p>
                        <h4 class="text-sm font-bold text-gray-900 uppercase truncate" title="${nomeDisciplina}">${nomeDisciplina}</h4>
                    </div>
                </div>
            `;
        });

        const destaqueClasses = isDestaque
            ? 'border-2 border-blue-500 bg-blue-50/40 p-5 rounded-2xl shadow-sm relative'
            : 'pl-2 opacity-80 hover:opacity-100 transition-opacity duration-300';

        const tituloBadge = isDestaque
            ? '<span class="ml-3 bg-blue-500 text-white text-[9px] font-black px-2 py-1 rounded-full uppercase tracking-wider">Mês Atual</span>'
            : '';

        containerDash.innerHTML += `
            <div class="${destaqueClasses} mb-8">
                <h3 class="text-sm font-black text-gray-800 uppercase tracking-widest mb-4 flex items-center">
                    <span class="w-1.5 h-5 ${isDestaque ? 'bg-blue-600' : 'bg-gray-400'} rounded mr-2 inline-block"></span>
                    ${semObj.nome}
                    ${tituloBadge}
                </h3>
                <div class="carrossel-semestre flex gap-4 overflow-x-auto pb-4 no-scrollbar cursor-ew-resize relative" style="scroll-behavior: auto;">
                    ${cardsHTML}
                </div>
            </div>
        `;
    });

    aplicarEfeitoScrollMouse();
}

function aplicarEfeitoScrollMouse() {
    const carrosseis = document.querySelectorAll('.carrossel-semestre');

    carrosseis.forEach(carrossel => {
        let scrollAnimation = null;
        let velocidadeScroll = 0;

        const animarScroll = () => {
            if (velocidadeScroll !== 0) {
                carrossel.scrollLeft += velocidadeScroll;
                scrollAnimation = requestAnimationFrame(animarScroll);
            }
        };

        carrossel.addEventListener('mousemove', (e) => {
            const rect = carrossel.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const largura = rect.width;
            const zonaAtiva = 150;
            const velocidadeMaxima = 7;

            if (x < zonaAtiva) {
                const proporcao = 1 - (x / zonaAtiva);
                velocidadeScroll = -(velocidadeMaxima * proporcao);
                if (!scrollAnimation) scrollAnimation = requestAnimationFrame(animarScroll);
            } else if (x > largura - zonaAtiva) {
                const proporcao = 1 - ((largura - x) / zonaAtiva);
                velocidadeScroll = (velocidadeMaxima * proporcao);
                if (!scrollAnimation) scrollAnimation = requestAnimationFrame(animarScroll);
            } else {
                velocidadeScroll = 0;
                if (scrollAnimation) {
                    cancelAnimationFrame(scrollAnimation);
                    scrollAnimation = null;
                }
            }
        });

        carrossel.addEventListener('mouseleave', () => {
            velocidadeScroll = 0;
            if (scrollAnimation) {
                cancelAnimationFrame(scrollAnimation);
                scrollAnimation = null;
            }
        });
    });
}

async function abrirTelaDisciplina(indexBoletim) {
    const d = dadosBoletimAtual[indexBoletim];
    if (!d) return;

    const nomeDisc = d.disciplina || d.nome_disciplina || 'Disciplina';
    const mediaCalc = calcularMediaDisciplina(d);
    const faltasCalc = obterFaltas(d);

    document.getElementById('disc-nome').innerText = nomeDisc;
    document.getElementById('disc-curso').innerText = document.getElementById('select-curso-boletim').options[document.getElementById('select-curso-boletim').selectedIndex]?.text || 'Curso UNIVEAS';
    document.getElementById('disc-periodo').innerText = (d.data_inicio && d.data_fim) ? `${d.data_inicio} a ${d.data_fim}` : 'Período Contínuo';
    document.getElementById('disc-ch').innerText = (d.ch_total || d.carga_horaria || 40) + 'h';
    document.getElementById('disc-faltas').innerText = faltasCalc;
    document.getElementById('disc-media').innerText = (mediaCalc !== null && !isNaN(mediaCalc)) ? mediaCalc.toFixed(1) : '-';
    document.getElementById('disc-ementa').innerText = d.ementa || 'Nenhuma ementa detalhada informada para esta disciplina até o momento.';

    const divFoto = document.getElementById('disc-foto');
    const fotoCapa = (d.foto_modulo && d.foto_modulo.trim() !== '') ? d.foto_modulo.trim() : getCapaPadraoCursoAtivo();
    if (fotoCapa) {
        divFoto.querySelector('img').src = fotoCapa;
        divFoto.querySelector('img').classList.remove('hidden');
        divFoto.querySelector('div').classList.add('hidden');
    } else {
        divFoto.querySelector('img').classList.add('hidden');
        divFoto.querySelector('div').classList.remove('hidden');
    }

    const ulAval = document.getElementById('disc-lista-avaliacoes');
    ulAval.innerHTML = '';
    const avalPrevistas = Array.isArray(d.avaliacoes_previstas) && d.avaliacoes_previstas.length > 0
        ? d.avaliacoes_previstas
        : Object.keys(d.notas || {});

    if (avalPrevistas.length === 0) {
        ulAval.innerHTML = '<p class="text-xs text-orange-400">Nenhuma avaliação configurada.</p>';
    } else {
        avalPrevistas.forEach(tipo => {
            const nota = (d.notas && d.notas[tipo] !== undefined && d.notas[tipo] !== null && d.notas[tipo] !== '') ? d.notas[tipo] : 'Pendente';
            const bgCor = nota === 'Pendente' ? 'bg-orange-100 text-orange-600' : 'bg-green-100 text-green-700';
            ulAval.innerHTML += `
                <div class="bg-white border border-orange-100 p-3 rounded-xl flex items-center justify-between shadow-sm">
                    <div>
                        <p class="text-xs font-bold text-gray-800 uppercase">${tipo}</p>
                        <p class="text-[9px] text-gray-400 uppercase mt-0.5">Avaliação Oficial</p>
                    </div>
                    <span class="${bgCor} px-2 py-1 rounded text-xs font-black">${nota}</span>
                </div>
            `;
        });
    }

    const containerMat = document.getElementById('disc-lista-materiais');
    containerMat.innerHTML = '<p class="text-xs text-gray-400">Carregando materiais...</p>';
    const cursoId = document.getElementById('select-curso-boletim').value;
    const mats = await apiRequest(`/aluno/materiais/${cursoId}`);

    containerMat.innerHTML = '';
    if (mats && mats.length > 0) {
        let filtrados = mats.filter(m => (m.disciplina || '').trim().toUpperCase() === nomeDisc.trim().toUpperCase());
        if (filtrados.length === 0) filtrados = mats;

        filtrados.forEach(m => {
            containerMat.innerHTML += `
                <div class="flex items-center justify-between p-3 bg-gray-50 border border-gray-200 rounded-xl">
                    <div>
                        <p class="font-bold text-gray-800 text-xs">${m.titulo}</p>
                        <p class="text-[10px] text-gray-400">Postado em: ${m.data_postagem || 'Recente'}</p>
                    </div>
                    <a href="${m.url_arquivo}" target="_blank" download class="bg-blue-600 text-white px-3 py-1.5 rounded-lg text-[10px] font-bold flex items-center hover:bg-blue-700 transition">
                        <i data-feather="download" class="w-3 h-3 mr-1"></i> Acessar
                    </a>
                </div>
            `;
        });
        feather.replace();
    } else {
        containerMat.innerHTML = '<p class="text-xs text-gray-400">Nenhum material compartilhado para esta disciplina.</p>';
    }

    mudarTela('disciplina');
}
</script>

