async function carregarBoletim() {
    let cursoId = document.getElementById('select-curso-boletim').value;
    const selectDash = document.getElementById('select-curso-dash');

    if (!cursoId && selectDash && selectDash.value) {
        cursoId = selectDash.value;
        document.getElementById('select-curso-boletim').value = cursoId;
    } else if (cursoId && selectDash) {
        selectDash.value = cursoId;
    }

    const selectDisciplina = document.getElementById('select-disciplina-boletim');
    const tbody = document.getElementById('tbody-boletim');
    const containerDash = document.getElementById('container-semestres-dash');

    if (!cursoId) {
        selectDisciplina.classList.add('hidden');
        tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-400">Selecione um curso acima.</td></tr>';
        renderizarGraficoDesempenho([], []);
        if (containerDash) containerDash.innerHTML = '<p class="text-sm text-gray-400 py-10 text-center">Aguardando seleção do curso...</p>';
        return;
    }

    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-400">Buscando disciplinas e avaliações...</td></tr>';

    const resp = await apiRequest(`/aluno/boletim/${cursoId}`);
    dadosBoletimAtual = Array.isArray(resp) ? resp : (resp?.dados || resp?.notas || []);

    if (dadosBoletimAtual.length > 0) {
        selectDisciplina.innerHTML = '<option value="">Selecione a Disciplina...</option>';
        dadosBoletimAtual.forEach((d, index) => {
            selectDisciplina.innerHTML += `<option value="${index}">${d.disciplina || d.nome_disciplina}</option>`;
        });

        selectDisciplina.classList.remove('hidden');
        selectDisciplina.value = "0";
        renderizarDisciplinaSelecionada();
        renderizarDashboardAluno();
        atualizarKpisDashboardPorCurso();
    } else {
        selectDisciplina.classList.add('hidden');
        tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-400">Nenhum registro encontrado para este curso.</td></tr>';
        renderizarGraficoDesempenho([], []);
        if (containerDash) containerDash.innerHTML = '<p class="text-sm text-gray-400 py-10 text-center">Nenhum módulo encontrado para este curso.</p>';
    }
}

function renderizarDisciplinaSelecionada() {
    const indexStr = document.getElementById('select-disciplina-boletim').value;
    const tbody = document.getElementById('tbody-boletim');
    const thead = document.getElementById('thead-boletim');

    if (indexStr === "") {
        tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-400">Selecione uma disciplina acima.</td></tr>';
        renderizarGraficoDesempenho([], []);
        return;
    }

    const n = dadosBoletimAtual[parseInt(indexStr, 10)];
    if (!n) return;

    const nomeDisc = n.disciplina || n.nome_disciplina || 'Módulo';
    const faltas = obterFaltas(n);
    const notasObj = n.notas || {};
    const tiposAvaliacoes = Array.isArray(n.avaliacoes_previstas) && n.avaliacoes_previstas.length > 0
        ? n.avaliacoes_previstas
        : Object.keys(notasObj);

    let thHTML = `
        <th class="py-3 px-4">Disciplina / Módulo</th>
        <th class="py-3 px-4 text-center text-yellow-600">Faltas</th>
    `;
    tiposAvaliacoes.forEach(tipo => {
        thHTML += `<th class="py-3 px-4 text-center text-blue-600">${tipo}</th>`;
    });
    thHTML += `
        <th class="py-3 px-4 text-center">Média</th>
        <th class="py-3 px-4 text-center">Situação</th>
    `;
    thead.innerHTML = thHTML;

    let tdsNotas = '';
    let somaNotas = 0;
    let qtdNotasValidas = 0;
    let labelsGrafico = [];
    let dadosGrafico = [];

    tiposAvaliacoes.forEach(tipo => {
        const valNota = notasObj[tipo] !== undefined && notasObj[tipo] !== null && notasObj[tipo] !== ''
            ? parseFloat(notasObj[tipo])
            : null;

        if (valNota !== null && !isNaN(valNota)) {
            somaNotas += valNota;
            qtdNotasValidas++;
            tdsNotas += `<td class="py-4 px-4 text-center font-bold text-gray-800">${valNota.toFixed(1)}</td>`;
            labelsGrafico.push(tipo);
            dadosGrafico.push(valNota);
        } else {
            tdsNotas += `<td class="py-4 px-4 text-center text-gray-300">-</td>`;
            labelsGrafico.push(tipo);
            dadosGrafico.push(0);
        }
    });

    let mediaFinal = null;
    if (n.media_final !== undefined && n.media_final !== null && n.media_final !== '') {
        mediaFinal = parseFloat(n.media_final);
    } else if (qtdNotasValidas > 0) {
        mediaFinal = somaNotas / qtdNotasValidas;
    }

    let mediaStr = mediaFinal !== null && !isNaN(mediaFinal) ? mediaFinal.toFixed(1) : '-';
    let badge = `<span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-[10px] uppercase font-bold tracking-wider">Cursando</span>`;
    const situacaoOficial = n.situacao || null;

    if (situacaoOficial) {
        if (situacaoOficial.toLowerCase().includes('aprovado')) {
            badge = `<span class="px-2 py-1 bg-green-100 text-green-700 rounded text-[10px] uppercase font-bold tracking-wider">${situacaoOficial}</span>`;
        } else if (situacaoOficial.toLowerCase().includes('reprovado')) {
            badge = `<span class="px-2 py-1 bg-red-100 text-red-700 rounded text-[10px] uppercase font-bold tracking-wider">${situacaoOficial}</span>`;
        } else {
            badge = `<span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded text-[10px] uppercase font-bold tracking-wider">${situacaoOficial}</span>`;
        }
    } else if (mediaFinal !== null && !isNaN(mediaFinal)) {
        if (mediaFinal >= 7.0) {
            badge = `<span class="px-2 py-1 bg-green-100 text-green-700 rounded text-[10px] uppercase font-bold tracking-wider">Aprovado</span>`;
        } else if (tiposAvaliacoes.length > 0 && qtdNotasValidas === tiposAvaliacoes.length) {
            badge = `<span class="px-2 py-1 bg-red-100 text-red-700 rounded text-[10px] uppercase font-bold tracking-wider">Em Recuperação</span>`;
        }
    }

    tbody.innerHTML = `
        <tr class="hover:bg-gray-50 transition-colors border-b border-gray-50">
            <td class="py-4 px-4 font-bold text-gray-900">${nomeDisc}</td>
            <td class="py-4 px-4 text-center text-yellow-600 font-bold">${faltas}</td>
            ${tdsNotas}
            <td class="py-4 px-4 text-center font-black ${mediaFinal !== null && mediaFinal >= 7 ? 'text-green-600' : 'text-gray-800'}">${mediaStr}</td>
            <td class="py-4 px-4 text-center">${badge}</td>
        </tr>
    `;

    renderizarGraficoDesempenho(labelsGrafico, dadosGrafico);
    if (typeof feather !== 'undefined') feather.replace();
}

function renderizarGraficoDesempenho(labels, dados) {
    const ctx = document.getElementById('graficoDesempenhoAluno');
    if (!ctx) return;

    if (meuGraficoDesempenho) {
        meuGraficoDesempenho.destroy();
    }

    const labelGrafico = labels.length > 0 ? 'Nota Obtida' : 'Aguardando Avaliações';

    meuGraficoDesempenho = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels.length > 0 ? labels : ['Sem Avaliações'],
            datasets: [{
                label: labelGrafico,
                data: dados.length > 0 ? dados : [0],
                backgroundColor: 'rgba(59, 130, 246, 0.7)',
                borderColor: 'rgb(37, 99, 235)',
                borderWidth: 1,
                borderRadius: 8,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    max: 10,
                    ticks: { stepSize: 2 }
                }
            },
            plugins: {
                legend: { display: false }
            }
        }
    });
}

async function carregarMateriais() {
    const cursoId = document.getElementById('select-curso-material').value;
    const selectDiscMat = document.getElementById('select-disciplina-material');
    const lista = document.getElementById('lista-materiais-aluno');

    if (!cursoId) {
        materiaisCursoAtual = [];
        if (selectDiscMat) selectDiscMat.classList.add('hidden');
        lista.innerHTML = '<p class="text-sm text-gray-400 text-center py-8">Selecione um curso para ver os materiais.</p>';
        return;
    }

    lista.innerHTML = '<p class="text-sm text-gray-400 text-center py-8">Buscando arquivos...</p>';

    const materiais = await apiRequest(`/aluno/materiais/${cursoId}`);
    materiaisCursoAtual = Array.isArray(materiais) ? materiais : [];

    if (materiaisCursoAtual.length > 0) {
        const disciplinasUnicas = [...new Set(materiaisCursoAtual.map(m => (m.disciplina || 'Geral').trim()))];
        if (selectDiscMat) {
            selectDiscMat.innerHTML = '<option value="">Todas as Disciplinas</option>';
            disciplinasUnicas.forEach(disc => {
                selectDiscMat.innerHTML += `<option value="${disc}">${disc}</option>`;
            });
            selectDiscMat.classList.remove('hidden');
        }
        filtrarMateriaisPorDisciplina();
    } else {
        if (selectDiscMat) selectDiscMat.classList.add('hidden');
        lista.innerHTML = '<p class="text-sm text-gray-400 text-center py-8">Nenhum material compartilhado pelo professor ainda.</p>';
    }
}

function filtrarMateriaisPorDisciplina() {
    const lista = document.getElementById('lista-materiais-aluno');
    const selectDiscMat = document.getElementById('select-disciplina-material');
    const filtroDisc = selectDiscMat ? selectDiscMat.value : '';

    const filtrados = filtroDisc
        ? materiaisCursoAtual.filter(m => (m.disciplina || 'Geral').trim() === filtroDisc)
        : materiaisCursoAtual;

    if (filtrados.length === 0) {
        lista.innerHTML = '<p class="text-sm text-gray-400 text-center py-8">Nenhum material encontrado para esta disciplina.</p>';
        return;
    }

    lista.innerHTML = '';
    filtrados.forEach(m => {
        lista.innerHTML += `
            <div class="flex items-center justify-between p-4 bg-white border border-gray-200 rounded-xl hover:shadow-sm transition group">
                <div class="flex items-center">
                    <div class="bg-blue-50 text-blue-500 p-3 rounded-lg mr-4">
                        <i data-feather="file-text" class="h-5 w-5"></i>
                    </div>
                    <div>
                        <p class="font-bold text-gray-800 text-sm">${m.titulo}</p>
                        <p class="text-xs text-gray-400 mt-0.5">Postado em: ${m.data_postagem || 'Recente'} • ${m.disciplina || 'Geral'}</p>
                    </div>
                </div>
                <a href="${m.url_arquivo}" target="_blank" download class="bg-gray-100 text-gray-700 hover:bg-blue-500 hover:text-white transition px-4 py-2 rounded-lg text-xs font-bold flex items-center">
                    <i data-feather="download" class="w-3 h-3 mr-2"></i> Baixar
                </a>
            </div>
        `;
    });
    feather.replace();
}

